# ============================================================
# ORIGIN HUT
# Environment configuration template
# Never commit real credentials.
# ============================================================

NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://originhut:change-me@localhost:5432/originhut

# External integrations
# Optional. When configured, Origin Hut can use the authenticated
# UN Comtrade Data API. Never commit the real key.
UN_COMTRADE_API_KEY=
WTO_API_KEY=
OPEN_CORPORATES_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Azure production variables will be added later.
POSTGRES_USER=originhut
POSTGRES_PASSWORD=change-me
POSTGRES_DB=originhut
POSTGRES_HOST_PORT=5432


